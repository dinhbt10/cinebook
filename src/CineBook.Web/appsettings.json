{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoMigrate": true,
    "Seed": true
  },
  "KeepAwake": {
    "Enabled": false,
    "IntervalMinutes": 10
  },
  "Booking": {
    "HoldMinutes": 8,
    "MaxSeatsPerBooking": 8,
    "MinutesBeforeStartToBlock": 15,
    "RoomCleanupMinutes": 15,
    "RefundFullBeforeHours": 24,
    "RefundPartialBeforeHours": 2,
    "RefundPartialRate": 0.8,
    "CheckInOpenBeforeMinutes": 60,
    "CheckInCloseAfterMinutes": 30,
    "ExpireJobIntervalMinutes": 30
  },
  "Jwt": {
    "Issuer": "CineBook",
    "Audience": "CineBookClient",
    "ExpiresHours": 8
  },
  "Payment": {
    "Mock": {
      "PayPageUrl": "/mock-gateway",
      "Enabled": false
    },
    "VnPay": {
      "TmnCode": "",
      "HashSecret": "",
      "PayUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
      "ApiUrl": "https://sandbox.vnpayment.vn/merchant_webapi/api/transaction",
      "Locale": "vn",
      "DefaultMethod": "",
      "ExpireMinutes": 15,
      "SimulateRefund": true
    }
  }
}
