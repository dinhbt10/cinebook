@model BookingPageViewModel
@{
    var booking = Model.Booking!;
    var providers = Model.Providers;
    var active = providers.FirstOrDefault(p => p.Provider == Model.Provider) ?? providers.FirstOrDefault();
    var chosenProvider = active != null ? active.Provider : "Mock";
    var chosenMethod = Model.Method ?? (active != null && active.Methods.Count > 0 ? active.Methods[0].Code : "");
}
<div class="surface p-5 sm:p-7" data-confirm data-provider="@chosenProvider" data-method="@chosenMethod">
    <h2 class="mb-1 text-lg font-bold">Xác nhận và thanh toán</h2>
    <p class="mb-5 text-[13px] text-faint">@(Model.Resumed
        ? "Bạn đang có đơn giữ ghế cho suất này. Thanh toán tiếp trước khi hết giờ, hoặc hủy để chọn lại ghế."
        : "Ghế đã được giữ cho bạn. Hoàn tất thanh toán trước khi hết giờ, nếu không ghế sẽ được trả lại cho người khác.")</p>

    <dl class="flex flex-col gap-2.5 text-sm">
        <div class="flex items-baseline justify-between gap-4">
            <dt class="shrink-0 text-faint">Mã đặt vé</dt>
            <dd class="text-right font-medium"><span class="font-mono font-bold text-brand-400">@booking.Code</span></dd>
        </div>
        <div class="flex items-baseline justify-between gap-4">
            <dt class="shrink-0 text-faint">Phim</dt>
            <dd class="text-right font-medium">@booking.MovieTitle</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4">
            <dt class="shrink-0 text-faint">Rạp</dt>
            <dd class="text-right font-medium">@booking.CinemaName · @booking.RoomName</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4">
            <dt class="shrink-0 text-faint">Suất chiếu</dt>
            <dd class="text-right font-medium">@Fmt.FullDateTime(booking.StartsAtUtc)</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4">
            <dt class="shrink-0 text-faint">Ghế</dt>
            <dd class="text-right font-medium">@string.Join(", ", booking.Seats.Select(s => s.Label))</dd>
        </div>
    </dl>

    @if (providers.Count > 0)
    {
        <div class="mt-6 flex flex-col gap-5">
            <div>
                <p class="mb-3 text-[13px] font-semibold text-muted">Cổng thanh toán</p>
                <div class="grid gap-2.5 sm:grid-cols-2">
                    @foreach (var g in providers)
                    {
                        var on = g.Provider == chosenProvider;
                        <button type="button" data-provider-option="@g.Provider" aria-pressed="@(on ? "true" : "false")"
                                class="@HtmlExtensions.Css("flex items-center gap-3 rounded-xl border px-4 py-3 text-left transition-all", on ? "border-brand-500 bg-brand-950/60" : "border-ink-600 bg-ink-900 hover:border-ink-500")">
                            <span data-provider-icon class="@HtmlExtensions.Css("flex h-9 w-9 shrink-0 items-center justify-center rounded-lg", on ? "bg-brand-500 text-on-brand" : "bg-ink-800 text-muted")">
                                @Html.Icon(g.Provider == "VNPay" ? "qr-code" : "credit-card", 16)
                            </span>
                            <span class="min-w-0"><span class="block truncate text-sm font-medium">@g.DisplayName</span><span class="block text-[11px] text-faint">@(g.Provider == "VNPay" ? "Quét mã QR, thẻ ATM hoặc thẻ quốc tế" : "Mô phỏng cho môi trường học tập")</span></span>
                            <span data-provider-check style="@(on ? "display:contents" : "display:none")">@Html.Icon("check", 16, "ml-auto shrink-0 text-brand-400")</span>
                        </button>
                    }
                </div>
            </div>

            @foreach (var g in providers)
            {
                if (g.Methods.Count <= 1)
                {
                    continue;
                }
                var visible = g.Provider == chosenProvider;
                var current = visible ? chosenMethod : g.Methods[0].Code;
                <div data-methods="@g.Provider" style="@(visible ? null : "display:none")">
                    <p class="mb-3 text-[13px] font-semibold text-muted">Cách thanh toán</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var m in g.Methods)
                        {
                            var on = m.Code == current;
                            var icon = m.Code == "VNPAYQR" ? "qr-code" : m.Code == "VNBANK" ? "landmark" : m.Code == "INTCARD" ? "globe" : "credit-card";
                            <button type="button" data-method-option="@m.Code" aria-pressed="@(on ? "true" : "false")"
                                    class="@HtmlExtensions.Css("flex items-center gap-2 rounded-xl border px-3.5 py-2 text-[13px] transition-all", on ? "border-brand-500 bg-brand-500 font-semibold text-on-brand" : "border-ink-600 bg-ink-900 text-muted hover:border-ink-500 hover:text-cream")">
                                @Html.Icon(icon, 14) @m.DisplayName
                            </button>
                        }
                    </div>
                    <p data-qr-note class="mt-3 flex items-start gap-1.5 rounded-xl border border-ink-700 bg-ink-900 px-3.5 py-2.5 text-[12px] text-muted" style="@(current == "VNPAYQR" ? null : "display:none")">@Html.Icon("qr-code", 14, "mt-0.5 shrink-0 text-brand-400")Bấm thanh toán để sang trang VNPay, mã QR hiện ở đó. Mở app ngân hàng hoặc ví điện tử, quét mã rồi xác nhận — trang kết quả tự cập nhật.</p>
                </div>
            }

            <p class="flex items-start gap-1.5 text-[12px] text-faint">@Html.Icon("shield-check", 13, "mt-0.5 shrink-0 text-mint-400")Kết quả thanh toán được xác nhận bằng chữ ký từ cổng, hệ thống chỉ ghi nhận một lần.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="mt-5"><div class="@Ui.ErrorNote">@Model.Error</div></div>
    }

    <div class="mt-6 flex flex-wrap gap-3">
        <button type="submit" form="pay-form" data-pay class="@Ui.Button("primary", "lg")">
            @Html.Icon("credit-card", 16) Thanh toán @Fmt.Money(booking.Total)
        </button>
        <button type="submit" form="cancel-hold-form" data-cancel-hold class="@Ui.Button("ghost", "lg")">
            Hủy và chọn lại ghế
        </button>
    </div>
</div>
