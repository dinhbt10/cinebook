@model List<CinemaCardViewModel>
@{
    var cities = (List<string>)ViewBag.Cities;
    var chip = "rounded-full px-4 py-2 text-[13px] transition-colors";
    var chipOn = chip + " bg-brand-500 font-semibold text-on-brand";
    var chipOff = chip + " border border-ink-700 text-muted hover:border-ink-600 hover:bg-ink-850 hover:text-cream";
}
<div class="mx-auto max-w-5xl px-4 py-10">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div class="min-w-0">
            <p class="mb-2 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-500">
                <span class="h-px w-6 bg-brand-600/70"></span>Hệ thống
            </p>
            <h2 class="font-display text-2xl font-extrabold md:text-[28px]">Rạp CineBook</h2>
            <p class="mt-1.5 max-w-xl text-sm text-faint">Chọn thành phố để xem các cụm rạp và phòng chiếu.</p>
        </div>
    </div>

    <div class="mb-7 flex flex-wrap gap-2">
        <button type="button" data-city="" class="@chipOn">Toàn quốc</button>
        @foreach (var c in cities)
        {
            <button type="button" data-city="@c" class="@chipOff">@c</button>
        }
    </div>

    <div id="cinema-list">
        <partial name="_CinemaList" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var chip = 'rounded-full px-4 py-2 text-[13px] transition-colors';
            var chipOn = chip + ' bg-brand-500 font-semibold text-on-brand';
            var chipOff = chip + ' border border-ink-700 text-muted hover:border-ink-600 hover:bg-ink-850 hover:text-cream';
            var requestNo = 0;

            $('[data-city]').on('click', function () {
                var city = $(this).attr('data-city');
                $('[data-city]').each(function () {
                    $(this).attr('class', $(this).attr('data-city') === city ? chipOn : chipOff);
                });

                var current = ++requestNo;
                $.ajax({
                    url: '/Cinemas/List',
                    data: { city: city },
                    success: function (response) {
                        if (current === requestNo) $('#cinema-list').html(response);
                    }
                });
            });
        });
    </script>
}
