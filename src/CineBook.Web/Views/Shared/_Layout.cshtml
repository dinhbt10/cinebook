@{
    var theme = Context.Request.Cookies["theme"] == "light" ? "light" : "dark";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isStaff = User.IsInRole("Staff") || User.IsInRole("CinemaManager") || User.IsInRole("Admin");
    var isManager = User.IsInRole("CinemaManager") || User.IsInRole("Admin");

    var nav = new[]
    {
        new { Controller = "Home", Action = "Index", Label = "Trang chủ", Active = controller == "Home" && action == "Index" },
        new { Controller = "Movies", Action = "Index", Label = "Phim", Active = controller == "Movies" },
        new { Controller = "Cinemas", Action = "Index", Label = "Rạp chiếu", Active = controller == "Cinemas" },
        new { Controller = "Promotions", Action = "Index", Label = "Ưu đãi", Active = controller == "Promotions" },
    };
}
<!DOCTYPE html>
<html lang="vi" data-theme="@theme">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="flex min-h-screen flex-col">
        <header class="sticky top-0 z-40 border-b border-ink-800 bg-ink-950/85 backdrop-blur-xl">
            <div aria-hidden="true" class="absolute inset-x-0 -bottom-px h-px bg-gradient-to-r from-transparent via-brand-600/45 to-transparent"></div>
            <div class="mx-auto flex h-16 max-w-6xl items-center gap-7 px-4">
                <a asp-controller="Home" asp-action="Index" asp-area="" class="flex shrink-0 items-center gap-2">
                    @Html.Icon("clapperboard", 22, "text-brand-500")
                    <span class="font-display text-lg font-extrabold tracking-tight">CineBook</span>
                </a>

                <nav class="hidden items-center gap-6 md:flex">
                    @foreach (var n in nav)
                    {
                        <a asp-controller="@n.Controller" asp-action="@n.Action" asp-area=""
                           class="relative py-1.5 text-sm transition-colors @(n.Active ? "text-cream font-medium after:absolute after:-bottom-px after:left-0 after:h-[2px] after:w-full after:rounded-full after:bg-brand-500" : "text-muted hover:text-cream")">@n.Label</a>
                    }
                </nav>

                <div class="ml-auto flex items-center gap-2">
                    <partial name="_ThemeToggle" />
                    @if (isStaff)
                    {
                        <a asp-controller="CheckIn" asp-action="Index" asp-area="" class="@Ui.Button("ghost", "sm", "hidden sm:inline-flex")">
                            @Html.Icon("scan-line", 15) Soát vé
                        </a>
                    }
                    @if (isManager)
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@Ui.Button("ghost", "sm", "hidden sm:inline-flex")">
                            @Html.Icon("layout-dashboard", 15) Quản trị
                        </a>
                    }

                    <partial name="_LoginPartial" />

                    <button type="button" data-menu-toggle
                            class="rounded-lg p-2 text-muted transition-colors hover:bg-ink-800 md:hidden">
                        <span data-menu-icon="closed">@Html.Icon("menu", 19)</span>
                        <span data-menu-icon="open" class="hidden">@Html.Icon("x", 19)</span>
                    </button>
                </div>
            </div>

            <div data-menu class="hidden border-t border-ink-800 bg-ink-950 px-4 py-3 md:hidden">
                <div class="flex flex-col gap-1">
                    @foreach (var n in nav)
                    {
                        <a asp-controller="@n.Controller" asp-action="@n.Action" asp-area=""
                           class="rounded-lg px-3 py-2.5 text-sm text-muted hover:bg-ink-800 hover:text-cream">@n.Label</a>
                    }
                    <div class="my-2 h-px bg-ink-800"></div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Tickets" asp-action="Index" asp-area=""
                           class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm text-muted hover:bg-ink-800">
                            @Html.Icon("ticket", 15) Vé của tôi
                        </a>
                        @if (isStaff)
                        {
                            <a asp-controller="CheckIn" asp-action="Index" asp-area=""
                               class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm text-muted hover:bg-ink-800">
                                @Html.Icon("scan-line", 15) Soát vé
                            </a>
                        }
                        @if (isManager)
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                               class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm text-muted hover:bg-ink-800">
                                @Html.Icon("layout-dashboard", 15) Trang quản trị
                            </a>
                        }
                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post">
                            <button type="submit"
                                    class="flex w-full items-center gap-2 rounded-lg px-3 py-2.5 text-left text-sm text-velvet-400 hover:bg-ink-800">
                                @Html.Icon("log-out", 15) Đăng xuất
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="flex gap-2 pt-1">
                            <a asp-controller="Account" asp-action="Login" asp-area="" class="@Ui.Button("secondary", "sm", "flex-1")">Đăng nhập</a>
                            <a asp-controller="Account" asp-action="Register" asp-area="" class="@Ui.Button("primary", "sm", "flex-1")">Đăng ký</a>
                        </div>
                    }
                </div>
            </div>
        </header>

        <main class="flex-1">@RenderBody()</main>

        <footer class="mt-20 border-t border-ink-800 bg-ink-900">
            <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
                <div>
                    <div class="mb-3 flex items-center gap-2">
                        @Html.Icon("clapperboard", 18, "text-brand-500")
                        <span class="font-display font-extrabold">CineBook</span>
                    </div>
                    <p class="text-[13px] leading-relaxed text-faint">
                        Đặt vé xem phim trực tuyến, chọn ghế theo thời gian thực, nhận vé điện tử ngay sau khi thanh toán.
                    </p>
                </div>
                <div>
                    <p class="mb-3 text-[13px] font-semibold">Khám phá</p>
                    <ul class="flex flex-col gap-2 text-[13px] text-faint">
                        <li><a asp-controller="Movies" asp-action="Index" asp-area="" class="transition-colors hover:text-brand-400">Phim đang chiếu</a></li>
                        <li><a asp-controller="Movies" asp-action="Index" asp-area="" class="transition-colors hover:text-brand-400">Phim sắp chiếu</a></li>
                        <li><a asp-controller="Cinemas" asp-action="Index" asp-area="" class="transition-colors hover:text-brand-400">Rạp chiếu</a></li>
                        <li><a asp-controller="Promotions" asp-action="Index" asp-area="" class="transition-colors hover:text-brand-400">Ưu đãi</a></li>
                    </ul>
                </div>
                <div>
                    <p class="mb-3 text-[13px] font-semibold">Hỗ trợ</p>
                    <ul class="flex flex-col gap-2 text-[13px] text-faint">
                        <li><a asp-controller="Tickets" asp-action="Index" asp-area="" class="transition-colors hover:text-brand-400">Vé của tôi</a></li>
                        <li><a asp-controller="Promotions" asp-action="Index" asp-area="" class="transition-colors hover:text-brand-400">Chính sách hoàn vé</a></li>
                        <li><a asp-controller="Cinemas" asp-action="Index" asp-area="" class="transition-colors hover:text-brand-400">Hệ thống rạp</a></li>
                    </ul>
                </div>
                <div>
                    <p class="mb-3 text-[13px] font-semibold">Tổng đài</p>
                    <p class="font-display text-2xl font-extrabold text-gradient-brand">1900 6017</p>
                    <p class="mt-1 text-[13px] text-faint">8:00 – 22:00 hằng ngày</p>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/js/icons.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
