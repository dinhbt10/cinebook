@model PosterModel
@if (!MovieArt.IsPlaceholder(Model.Url))
{
    <img src="@Model.Url" alt="" aria-hidden="true" class="h-full w-full object-cover @Model.CssClass" />
}
else
{
    var art = MovieArt.For(Model.Title);
    var beamId = "beam-" + Guid.NewGuid().ToString("N").Substring(0, 8);
    <div class="on-dark h-full w-full @Model.CssClass" aria-hidden="true"
         style="background: @MovieArt.Background(Model.Title)">
        <svg viewBox="0 0 160 90" preserveAspectRatio="none" class="h-full w-full">
            <defs>
                <linearGradient id="@beamId" x1="0.5" y1="0" x2="0.2" y2="1">
                    <stop offset="0%" stop-color="@art.Glow" stop-opacity="0.30"></stop>
                    <stop offset="100%" stop-color="@art.Glow" stop-opacity="0"></stop>
                </linearGradient>
            </defs>
            <polygon points="82,-10 140,90 30,90" fill="url(#@beamId)"></polygon>
            <polygon points="52,-10 96,90 10,90" fill="url(#@beamId)" opacity="0.55"></polygon>
        </svg>
    </div>
}
