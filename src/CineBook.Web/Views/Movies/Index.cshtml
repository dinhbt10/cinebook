@model MovieGridViewModel
@{
    var genres = (List<GenreItem>)ViewBag.Genres;
    var chip = "rounded-full px-3.5 py-1.5 text-[13px] transition-colors";
    var chipOn = chip + " bg-brand-500 font-semibold text-on-brand";
    var chipOff = chip + " border border-ink-700 text-muted hover:border-ink-600 hover:bg-ink-850 hover:text-cream";
}
<div class="mx-auto max-w-6xl px-4 py-10">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div class="min-w-0">
            <p class="mb-2 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-500">
                <span class="h-px w-6 bg-brand-600/70"></span>Thư viện
            </p>
            <h2 class="font-display text-2xl font-extrabold md:text-[28px]">Danh sách phim</h2>
            <p class="mt-1.5 max-w-xl text-sm text-faint">Tìm theo tên, lọc theo trạng thái chiếu và thể loại.</p>
        </div>
        <span id="movie-count" class="text-[13px] text-faint">@Model.Total<!----> phim</span>
    </div>

    <div class="mb-8 flex flex-col gap-4">
        <div class="relative max-w-md">
            @Html.Icon("search", 16, "pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-faint")
            <input id="movie-search" type="text" autocomplete="off" placeholder="Tìm theo tên phim…" class="@Ui.Input("pl-10 pr-10")" />
            <button type="button" id="movie-search-clear" aria-label="Xoá từ khoá"
                    class="absolute right-3 top-1/2 -translate-y-1/2 rounded-md p-1 text-faint transition-colors hover:text-cream hidden">
                @Html.Icon("x", 14)
            </button>
        </div>

        <div class="flex flex-wrap gap-2">
            <button type="button" data-status="" class="@chipOn">Tất cả</button>
            <button type="button" data-status="NowShowing" class="@chipOff">Đang chiếu</button>
            <button type="button" data-status="ComingSoon" class="@chipOff">Sắp chiếu</button>
            <span class="mx-1 w-px self-stretch bg-ink-700"></span>
            <button type="button" data-genre="" class="@chipOn">Mọi thể loại</button>
            @foreach (var g in genres)
            {
                <button type="button" data-genre="@g.Id" class="@chipOff">@g.Name</button>
            }
        </div>
    </div>

    <div id="movie-results">
        <partial name="_MovieResults" model="Model" />
    </div>

    <partial name="_TrailerModal" />
</div>

@section Scripts {
    <script>
        $(function () {
            var chip = 'rounded-full px-3.5 py-1.5 text-[13px] transition-colors';
            var chipOn = chip + ' bg-brand-500 font-semibold text-on-brand';
            var chipOff = chip + ' border border-ink-700 text-muted hover:border-ink-600 hover:bg-ink-850 hover:text-cream';

            var filter = { q: '', status: '', genreId: '' };
            var pageNo = 0;
            var pageCount = @ViewBag.pageCount;
            var loading = false;
            var requestNo = 0;

            function markChips(attr, value) {
                $('[data-' + attr + ']').each(function () {
                    $(this).attr('class', $(this).attr('data-' + attr) === value ? chipOn : chipOff);
                });
            }

            function reload() {
                var current = ++requestNo;
                $.ajax({
                    url: '/Movies/Search',
                    data: filter,
                    success: function (response) {
                        if (current !== requestNo) return;
                        $('#movie-results').html(response);
                        var info = $('#movie-results [data-total]');
                        $('#movie-count').html(info.data('total') + '<!----> phim');
                        pageNo = 0;
                        pageCount = Number(info.data('page-count'));
                        loadMoreIfNeeded();
                    }
                });
            }

            function atBottom() {
                return $(window).scrollTop() + $(window).height() >= $(document).height() - 100;
            }

            function loadMoreIfNeeded() {
                if (loading || pageNo + 1 >= pageCount || !atBottom()) return;
                loading = true;
                var current = requestNo;
                $.ajax({
                    url: '/Movies/LoadMore',
                    data: $.extend({ pageNo: pageNo + 1 }, filter),
                    success: function (response) {
                        loading = false;
                        if (current !== requestNo) return;
                        pageNo++;
                        $('#movie-results .grid').append($('<div>').html(response).find('.grid').children());
                        loadMoreIfNeeded();
                    },
                    error: function () {
                        loading = false;
                    }
                });
            }

            $(window).scroll(loadMoreIfNeeded);

            $('#movie-search').on('keyup input', function () {
                var q = $(this).val();
                $('#movie-search-clear').toggleClass('hidden', q === '');
                if (q === filter.q) return;
                filter.q = q;
                reload();
            });

            $('#movie-search-clear').on('click', function () {
                $('#movie-search').val('');
                $(this).addClass('hidden');
                filter.q = '';
                reload();
            });

            $('[data-status]').on('click', function () {
                filter.status = $(this).attr('data-status');
                markChips('status', filter.status);
                reload();
            });

            $('[data-genre]').on('click', function () {
                filter.genreId = $(this).attr('data-genre');
                markChips('genre', filter.genreId);
                reload();
            });

            loadMoreIfNeeded();
        });
    </script>
}
