{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "rewrites": [
    { "source": "/api/:path*", "destination": "https://cinebook-api-c0gw.onrender.com/api/:path*" },
    { "source": "/mock-gateway", "destination": "https://cinebook-api-c0gw.onrender.com/mock-gateway" },
    { "source": "/mock-gateway/:path*", "destination": "https://cinebook-api-c0gw.onrender.com/mock-gateway/:path*" },
    { "source": "/swagger/:path*", "destination": "https://cinebook-api-c0gw.onrender.com/swagger/:path*" },

    { "source": "/(.*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
